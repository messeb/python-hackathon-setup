# Copy to backend/.env (git-ignored). Every setting is APP_<NAME>; see src/app/core/config.py.
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO

# LLM provider: fake (offline echo) | anthropic | openai (any OpenAI-compatible server)
APP_LLM_PROVIDER=fake

# --- Anthropic (Claude) ---
# APP_LLM_PROVIDER=anthropic
# APP_LLM_MODEL=claude-opus-5-5
# APP_LLM_EFFORT=medium
# APP_ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI-compatible (OpenAI, Ollama, vLLM, LM Studio, LiteLLM) ---
# APP_LLM_PROVIDER=openai
# APP_LLM_MODEL=llama3.2
# APP_OPENAI_BASE_URL=http://localhost:11434/v1
# APP_OPENAI_API_KEY=

# PyTorch: auto | cpu | cuda | mps
APP_TORCH_DEVICE=auto
